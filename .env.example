SECRET_KEY=change-me
DEBUG=True
# Isi IP/domain server aktif di sini. Contoh: 10.24.80.245 atau labhub.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,10.24.80.245,10.24.80.32
PUBLIC_ACCESS_BASE_URL=http://10.24.80.245:8000

# Titik Jurusan Teknik Informatika FTI Universitas Trisakti.
ABSENSI_CENTER_LATITUDE=-6.1680678
ABSENSI_CENTER_LONGITUDE=106.7916257
ABSENSI_RADIUS_METERS=150
ABSENSI_MAX_GPS_ACCURACY_METERS=100
ABSENSI_EARLY_CHECKIN_MINUTES=30
ABSENSI_MAX_PHOTO_SIZE_MB=5
ABSENSI_MAX_VIDEO_SIZE_MB=25
ABSENSI_MAX_VIDEO_DURATION_SECONDS=15
MOBILE_JWT_ACCESS_MINUTES=30
MOBILE_JWT_REFRESH_DAYS=7
# Kosongkan saat development untuk mengizinkan seluruh origin. Produksi: pisahkan dengan koma.
CORS_ALLOWED_ORIGINS=

# Opsional untuk deployment multi-process. Kosong = InMemoryChannelLayer development.
CHANNEL_REDIS_URL=

# Folder penyimpanan upload Django di luar proyek.
# Windows contoh: MEDIA_ROOT=D:/LabHub/media
# AlmaLinux contoh: MEDIA_ROOT=/var/www/labhub/media
MEDIA_URL=/media/
MEDIA_ROOT=media

DB_NAME=project_laboran
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Ganti EMAIL_HOST_PASSWORD dengan password/app-password email pengirim.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=Labtif.fti@trisakti.ac.id
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Labtif.fti@trisakti.ac.id
